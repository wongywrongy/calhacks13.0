# Bitdeer credentials stay on the server. Chat defaults to GLM-5.3-Flash for both roles.
BITDEER_API_KEY=
BITDEER_COORDINATOR_MODEL=zai-org/GLM-5.3-Flash
BITDEER_SPECIALIST_MODEL=zai-org/GLM-5.3-Flash
# Optional coordinator upgrade: zai-org/GLM-5.3. No automatic escalation/retry.
BITDEER_CONCURRENCY=4
# Separate legacy HTTP-suite model (only needed for /v1/runs with engine=bitdeer).
BITDEER_MODEL=zai-org/GLM-5.3-Flash

# Existing arena-live module, published by this server identity.
SPACETIME_URI=http://127.0.0.1:3000
SPACETIME_DATABASE=sudoko-live
SPACETIME_TOKEN=
# Distinct random secrets, each at least 32 characters. Never browser credentials.
SUDOKO_OPERATOR_TOKEN=
SUDOKO_OBSERVER_TOKEN=
SUDOKO_ATTACKER_TOKEN=
SUDOKO_DEFENDER_TOKEN=
# Optional separate session-encryption secret; otherwise derived from operator secret.
SUDOKO_SESSION_SECRET=
# Required when serving browsers through a remote HTTPS ingress; no trailing slash.
SUDOKO_PUBLIC_ORIGIN=
# Set when browsers reach SpacetimeDB through a different public address.
FLEET_PUBLIC_URI=

# Hackathon-only: visitors may switch both roles without signing in. Off by default.
# SUDOKO_DEMO_MODE=1
# SUDOKO_DEMO_ATTACKER_VIEWER_TOKEN=
# SUDOKO_DEMO_DEFENDER_VIEWER_TOKEN=
