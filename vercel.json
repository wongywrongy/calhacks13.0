{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "output/vercel-static",
  "rewrites": [
    {
      "source": "/fleet-config",
      "destination": "/fleet-config.json"
    }
  ],
  "headers": [
    {
      "source": "/fleet-config(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
